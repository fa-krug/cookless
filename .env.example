# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty for SQLite)
DATABASE_URL=

# Data directory for SQLite + media uploads (default: backend/)
# Set to /data in Docker with a mounted volume for persistence
# DATA_DIR=/data

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# WebAuthn / Passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Cook Less
WEBAUTHN_ORIGIN=http://localhost:5173

# Superuser (auto-created on container startup if both are set)
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
SERVER_EMAIL=server@localhost
ADMIN_EMAIL=
